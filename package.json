{
  "name": "pool4ward-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "showcase:check": "node scripts/showcase/publish.mjs --check",
    "prebuild": "npm run showcase:check",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "showcase:publish": "node scripts/showcase/publish.mjs",
    "showcase:demo": "node scripts/showcase/publish.mjs --from scripts/showcase/example.source.json --mode demo",
    "poster:levers": "esbuild scripts/build-levers-poster.ts --bundle --platform=node --format=esm --alias:@=./src | node --input-type=module"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.344.0",
    "maplibre-gl": "5.24.0",
    "next": "14.2.35",
    "next-intl": "^4.8.3",
    "react": "^18",
    "react-dom": "^18",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/topojson-client": "3.1.5",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "topojson-client": "3.1.0",
    "typescript": "^5",
    "vitest": "^2.1.9",
    "world-atlas": "2.0.2"
  }
}
